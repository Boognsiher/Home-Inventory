# Anthropic API Key für Visual Search (Claude Haiku Bildidentifikation)
# Nie einchecken - diese Datei nur als Vorlage nach .env kopieren!
ANTHROPIC_API_KEY=sk-ant-...

# Zufälliger, geheimer Wert für Flask-Sessions (z. B. mit `openssl rand -hex 32` erzeugen)
SECRET_KEY=bitte-aendern

# Verzeichnis für alle persistenten Daten (inventory.json, Fotos, Backups).
# Im Docker-Container zeigt das auf das gemountete Volume, siehe docker-compose.yml.
DATA_DIR=/app/data

# Maximale Upload-Größe in MB (z. B. für Fotos)
MAX_CONTENT_LENGTH_MB=16

# Wie viele ZIP-Backups aufbewahrt werden
BACKUP_KEEP=30

# Uhrzeit (Stunde, 0-23) für das automatische nächtliche Backup
BACKUP_STUNDE=3

# --- Nur für Fernzugriff / öffentliche Erreichbarkeit relevant ---

# Passwortschutz: leer lassen für reine Heimnetz-Nutzung (kein Login).
# Bei Internet-Zugriff zwingend setzen! Ein sicheres Passwort wählen,
# z. B. erzeugt mit `openssl rand -base64 18`.
APP_PASSWORT=

# Wie viele Tage der Login-Cookie gültig bleibt
SESSION_TAGE=30

# Eigener DDNS-Hostname oder Domain für den optionalen Caddy-Reverse-Proxy
# (siehe README.md "Fernzugriff über das Internet"). Nur nötig, wenn die App
# öffentlich erreichbar sein soll.
PUBLIC_DOMAIN=
