# Anthropic API Key für Visual Search (Claude Haiku Bildidentifikation)
# Nie einchecken - diese Datei nur als Vorlage nach .env kopieren!
ANTHROPIC_API_KEY=sk-ant-...

# Zufälliger, geheimer Wert für Flask-Sessions (z. B. mit `openssl rand -hex 32` erzeugen)
SECRET_KEY=bitte-aendern

# Verzeichnis für alle persistenten Daten (inventory.json, Fotos, Backups).
# Im Docker-Container zeigt das auf das gemountete Volume, siehe docker-compose.yml.
DATA_DIR=/app/data

# Maximale Upload-Größe in MB (z. B. für Fotos)
MAX_CONTENT_LENGTH_MB=16

# Wie viele ZIP-Backups aufbewahrt werden
BACKUP_KEEP=30

# Uhrzeit (Stunde, 0-23) für das automatische nächtliche Backup
BACKUP_STUNDE=3
